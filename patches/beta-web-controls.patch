 class Root():
+
+    # Adapted from recovered HAUTLLE app.py modes_page/mode_set.
+    # Inline page; no custom static frontend or Flask dependency.
+    def _hautlle_mode_paths(self):
+        root = '/sdcard/Modes/oFLua'
+        paths = []
+        for name in sorted(os.listdir(root)):
+            directory = os.path.join(root, name)
+            main = os.path.join(directory, 'main.lua')
+            if (os.path.isdir(directory) and not os.path.islink(directory)
+                    and os.path.isfile(main) and not os.path.islink(main)):
+                paths.append((name, main))
+        return paths
+
+    def modes(self):
+        if cherrypy.request.method != 'GET':
+            raise cherrypy.HTTPError(405, 'Use GET')
+        rows = []
+        for name, main in self._hautlle_mode_paths():
+            safe_name = cgi.escape(name, quote=True)
+            safe_main = cgi.escape(main, quote=True)
+            rows.append('<form method="post" action="/mode_set" target="sink" style="margin:0 0 1em 0">'
+                        '<input type="hidden" name="mode" value="' + safe_main + '">'
+                        '<button type="submit">Load</button> <b>' + safe_name + '</b><br>'
+                        '<code>' + safe_main + '</code></form>')
+        body = '<h2>OF/Lua Modes</h2>' + ''.join(rows) + '<iframe name="sink" style="display:none"></iframe>'
+        cherrypy.response.headers['Content-Type'] = 'text/html; charset=utf-8'
+        return '<!doctype html><html><body style="background:#111;color:#eee;font-family:monospace;padding:20px">' + body + '</body></html>'
+    modes.exposed = True
+
+    def mode_set(self, mode=''):
+        if cherrypy.request.method != 'POST':
+            raise cherrypy.HTTPError(405, 'Use POST')
+        if not mode or mode not in [path for name, path in self._hautlle_mode_paths()]:
+            raise cherrypy.HTTPError(400, 'Unknown live mode')
+        liblo.send(osc_target, '/set', mode)
+        cherrypy.response.headers['Content-Type'] = 'text/plain; charset=utf-8'
+        return 'mode set requested: ' + mode
+    mode_set.exposed = True
+
